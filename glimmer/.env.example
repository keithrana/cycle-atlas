# Copy this file, name the copy exactly:  .env   then edit it. NEVER share or commit .env
LAOZHANG_API_KEY=put-your-key-here
LAOZHANG_BASE_URL=https://api.laozhang.ai
IMAGE_MODEL=gpt-image-1
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open it to your home Wi-Fi/network.
HOST=127.0.0.1
# If HOST is 0.0.0.0, ALWAYS set a password (the username can be anything):
ACCESS_PASSWORD=
